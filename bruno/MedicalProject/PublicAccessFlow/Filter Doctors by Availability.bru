meta {
  name: Filter Doctors by Availability
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/users/doctors/search
  body: json
  auth: inherit
}

body:json {
  {
    "availability": {
      "dayOfWeek": 1,
      "startTime": "08:00",
      "endTime": "18:00"
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
