meta {
  name: Manage User
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/users/2
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{adminToken}}
}

body:json {
  {
    "name": "Nombre Actualizado",
    "email": "nuevo@email.com",
    "telephone": "999999999"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
